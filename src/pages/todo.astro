---
import { getCollection, render } from "astro:content";
import { Icon } from "astro-icon/components";
import { siteConfig, todoConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";

// 在 todoConfig 里关闭后，导航栏不显示入口，页面直接跳 404
if (!todoConfig.enable) {
	return Astro.redirect("/404/");
}

const MS_PER_DAY = 86_400_000;

const LOCALE_MAP: Record<string, string> = {
	zh_CN: "zh-CN",
	zh_TW: "zh-TW",
	en: "en-US",
	ja: "ja-JP",
	ru: "ru-RU",
};

const locale = LOCALE_MAP[siteConfig.lang] ?? "en-US";
const title = todoConfig.title || i18n(I18nKey.todo);
const description = todoConfig.description || i18n(I18nKey.todoDescription);
const heatmapTotalTemplate = i18n(I18nKey.todoHeatmapTotal);
const todayCountTemplate = i18n(I18nKey.todoTodayCount);

const entries = await getCollection("todos");

// 待办的正文会当作 markdown 备注渲染出来（可以写链接、列表、图片）
const items = await Promise.all(
	entries.map(async (entry) => {
		const progress = entry.data.progress ?? 0;
		const progressTotal = entry.data.progressTotal;
		const progressStep = entry.data.progressStep ?? 1;

		// checkins 每条是 "YYYY-MM-DD" 或 "YYYY-MM-DD HH:mm"（带时间的要加引号）
		// 同一天可以写多次（一天多次打卡），进度 = progress + 打卡次数 × progressStep
		const checkins = (entry.data.checkins ?? [])
			.map((value) =>
				value instanceof Date ? formatDateToYYYYMMDD(value) : String(value).trim(),
			)
			.filter(Boolean)
			.sort();
		// 只取日期部分用于墙 / 当天统计
		const checkinDays = checkins.map((value) => value.slice(0, 10));
		const value = progressTotal
			? Math.min(progressTotal, progress + checkins.length * progressStep)
			: progress;

		return {
			id: entry.id,
			title: entry.data.title,
			done: entry.data.done ?? false,
			description: entry.data.description ?? "",
			date: entry.data.date,
			progress,
			progressTotal,
			progressStep,
			progressUnit: entry.data.progressUnit ?? "",
			checkins,
			checkinDays,
			value,
			percent:
				progressTotal && progressTotal > 0
					? Math.min(100, Math.round((value / progressTotal) * 100))
					: 0,
			Note: entry.body?.trim() ? (await render(entry)).Content : null,
		};
	}),
);

// 未完成的排前面，完成的沉底；同组按日期倒序
const todos = items.sort((a, b) => {
	if (a.done !== b.done) return a.done ? 1 : -1;
	const aTime = a.date ? a.date.getTime() : 0;
	const bTime = b.date ? b.date.getTime() : 0;
	if (aTime !== bTime) return bTime - aTime;
	return a.title.localeCompare(b.title);
});

const total = todos.length;
const doneCount = todos.filter((todo) => todo.done).length;
const percent = total === 0 ? 0 : Math.round((doneCount / total) * 100);

/* ---------- 底部「打卡记录」小墙：所有待办的打卡汇总 ---------- */

const checkinCounts = new Map<string, number>();
for (const item of items) {
	for (const day of item.checkinDays) {
		checkinCounts.set(day, (checkinCounts.get(day) ?? 0) + 1);
	}
}
const wallTotal = [...checkinCounts.values()].reduce((sum, count) => sum + count, 0);

const weeks = Math.min(53, Math.max(4, Math.floor(todoConfig.heatmapWeeks ?? 26)));
const wallCell = 9;
const wallGap = 2;
const wallPitch = wallCell + wallGap;
const wallGutter = 22;
const wallLabelHeight = 12;
const wallGridWidth = weeks * wallPitch - wallGap;
const wallGridHeight = 7 * wallPitch - wallGap;

const timeZone = siteConfig.timezone;
const todayKey = new Intl.DateTimeFormat("en-CA", {
	year: "numeric",
	month: "2-digit",
	day: "2-digit",
	...(timeZone ? { timeZone } : {}),
}).format(new Date());

const todayUTC = new Date(`${todayKey}T00:00:00.000Z`);
const todayWeekday = todayUTC.getUTCDay();
const rangeStart = new Date(
	todayUTC.getTime() - (todayWeekday + (weeks - 1) * 7) * MS_PER_DAY,
);

type WallDay = {
	key: string;
	count: number;
	level: number;
	week: number;
	weekday: number;
};

const wallDays: WallDay[] = [];
for (let index = 0; index < weeks * 7; index += 1) {
	const date = new Date(rangeStart.getTime() + index * MS_PER_DAY);
	const key = date.toISOString().slice(0, 10);
	wallDays.push({
		key,
		count: checkinCounts.get(key) ?? 0,
		level: 0,
		week: Math.floor(index / 7),
		weekday: index % 7,
	});
}

const maxDayCount = Math.max(1, ...wallDays.map((day) => day.count));
for (const day of wallDays) {
	day.level =
		day.count === 0
			? 0
			: Math.min(4, Math.max(1, Math.ceil((day.count / maxDayCount) * 4)));
}
const wallActiveDays = wallDays.filter((day) => day.level > 0);

const monthFormatter = new Intl.DateTimeFormat(locale, {
	month: "short",
	timeZone: "UTC",
});
const monthLabels: { column: number; label: string }[] = [];
for (let week = 0; week < weeks; week += 1) {
	let labeled = false;
	for (let dayOfWeek = 0; dayOfWeek < 7 && !labeled; dayOfWeek += 1) {
		const date = new Date(`${wallDays[week * 7 + dayOfWeek].key}T00:00:00.000Z`);
		if (date.getUTCDate() !== 1) continue;
		if (monthLabels.some((item) => week - item.column < 3)) continue;
		monthLabels.push({ column: week, label: monthFormatter.format(date) });
		labeled = true;
	}
}
if (monthLabels.length === 0 || monthLabels[0].column > 3) {
	monthLabels.unshift({
		column: 0,
		label: monthFormatter.format(new Date(`${wallDays[0].key}T00:00:00.000Z`)),
	});
}

const weekdayFormatter = new Intl.DateTimeFormat(locale, {
	weekday: "short",
	timeZone: "UTC",
});
const referenceSunday = new Date("2024-01-07T00:00:00.000Z");
const weekdayLabels = Array.from({ length: 7 }, (_, index) =>
	index === 1 || index === 3 || index === 5
		? weekdayFormatter.format(
				new Date(referenceSunday.getTime() + index * MS_PER_DAY),
			)
		: "",
);

const wallPatternId = `todo-wall-${Math.random().toString(36).slice(2, 8)}`;
---

<MainGridLayout title={title} description={description}>
  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-6 py-6 md:px-9 relative w-full onload-animation">
      <!-- 标题 -->
      <div class="flex items-center gap-3 mb-5">
        <div class="flex items-center justify-center h-9 w-9 rounded-xl bg-(--btn-regular-bg) text-(--btn-content) text-[1.5rem] flex-none">
          <Icon name="material-symbols:checklist-rounded" />
        </div>
        <div class="min-w-0">
          <h2 class="text-2xl font-bold leading-tight text-(--deep-text) m-0">{title}</h2>
          <p class="text-sm text-(--content-meta) mt-1 mb-0">{description}</p>
        </div>
      </div>

      {
        todoConfig.showProgress !== false && (
          <div class="todo-progress">
            <div class="todo-progress-track">
              <div class="todo-progress-fill" data-todo-fill style={`width:${percent}%`} />
            </div>
            <div class="todo-progress-text">
              <span data-todo-done>{doneCount}</span>
              <span class="mx-0.5">/</span>
              <span data-todo-total>{total}</span>
              <span class="ml-1">{i18n(I18nKey.todoCompleted)}</span>
            </div>
          </div>
        )
      }

      {
        total === 0 ? (
          <p class="todo-empty">{i18n(I18nKey.todoEmpty)}</p>
        ) : (
          <ul class="todo-list">
            {todos.map((todo) => {
              const Note = todo.Note;
              return (
                <li
                  class="todo-item"
                  data-todo-id={todo.id}
                  data-checkins={todo.checkins.join(",")}
                >
                  <label class="todo-check">
                    <input
                      type="checkbox"
                      class="todo-checkbox"
                      checked={todo.done}
                      data-todo-checkbox
                      aria-label={todo.title}
                    />
                    <span class="todo-check-mark" aria-hidden="true">
                      <Icon name="material-symbols:check-rounded" />
                    </span>
                  </label>
                  <div class="todo-body">
                    <div class="todo-title-row">
                      <span class="todo-title">{todo.title}</span>
                      {todo.date && (
                        <span class="todo-date">{formatDateToYYYYMMDD(todo.date)}</span>
                      )}
                    </div>
                    {todo.description && <p class="todo-desc">{todo.description}</p>}

                    {todo.progressTotal ? (
                      <div
                        class="todo-progress-row"
                        data-todo-progress
                        data-base={todo.progress}
                        data-total={todo.progressTotal}
                        data-step={todo.progressStep}
                      >
                        <div class="todo-progress-track">
                          <div
                            class="todo-progress-fill"
                            data-todo-bar
                            style={`width:${todo.percent}%`}
                          />
                        </div>
                        <span class="todo-progress-count">
                          <span data-todo-progress-value>{todo.value}</span>
                          <span class="mx-0.5">/</span>
                          <span>{todo.progressTotal}</span>
                          {todo.progressUnit && (
                            <span class="ml-0.5">{todo.progressUnit}</span>
                          )}
                        </span>
                        <button type="button" class="todo-checkin" data-todo-checkin>
                          {i18n(I18nKey.todoCheckin)}
                        </button>
                        <button type="button" class="todo-undo" data-todo-undo hidden>
                          {i18n(I18nKey.todoUndo)}
                        </button>
                        <span class="todo-today" data-todo-today hidden />
                        <span class="todo-streak" data-todo-streak hidden />
                      </div>
                    ) : null}

                    {Note && (
                      <div class="todo-note prose dark:prose-invert prose-sm max-w-none! custom-md">
                        <Note />
                      </div>
                    )}
                  </div>
                </li>
              );
            })}
          </ul>
        )
      }

      <!-- 打卡记录小墙（数据来自各待办 markdown 里的 checkins） -->
      <div class="todo-wall">
        <div class="todo-wall-head">
          <span class="todo-wall-title">
            <Icon name="material-symbols:local-fire-department-rounded" class="todo-wall-icon" />
            {i18n(I18nKey.todoHeatmap)}
          </span>
          <span class="todo-wall-total" data-todo-wall-total>
            {heatmapTotalTemplate.replace("{count}", String(wallTotal))}
          </span>
        </div>

        <div class="todo-wall-scroll">
          <svg
            class="todo-wall-svg"
            width={wallGutter + wallGridWidth}
            height={wallLabelHeight + wallGridHeight}
            viewBox={`0 0 ${wallGutter + wallGridWidth} ${wallLabelHeight + wallGridHeight}`}
            role="img"
            aria-label={`${i18n(I18nKey.todoHeatmap)}：${heatmapTotalTemplate.replace("{count}", String(wallTotal))}`}
            data-pitch={wallPitch}
            data-cell={wallCell}
            data-gutter={wallGutter}
            data-label-h={wallLabelHeight}
            data-start={wallDays[0].key}
          >
            <defs>
              <pattern
                id={wallPatternId}
                width={wallPitch}
                height={wallPitch}
                patternUnits="userSpaceOnUse"
              >
                <rect width={wallCell} height={wallCell} rx="2" class="todo-wall-cell-empty" />
              </pattern>
            </defs>

            <rect
              x={wallGutter}
              y={wallLabelHeight}
              width={wallGridWidth - wallPitch}
              height={wallGridHeight}
              fill={`url(#${wallPatternId})`}
            />
            <rect
              x={wallGutter + wallGridWidth - wallPitch}
              y={wallLabelHeight}
              width={wallCell}
              height={(todayWeekday + 1) * wallPitch - wallGap}
              fill={`url(#${wallPatternId})`}
            />

            {
              wallActiveDays.map((day) => (
                <rect
                  x={wallGutter + day.week * wallPitch}
                  y={wallLabelHeight + day.weekday * wallPitch}
                  width={wallCell}
                  height={wallCell}
                  rx="2"
                  class="todo-wall-cell"
                  data-level={day.level}
                  data-wall-date={day.key}
                  data-count={day.count}
                >
                  <title>
                    {`${day.key} · ${heatmapTotalTemplate.replace("{count}", String(day.count))}`}
                  </title>
                </rect>
              ))
            }

            {
              monthLabels.map((month) => (
                <text
                  class:list={[
                    "todo-wall-month",
                    { "todo-wall-month-end": month.column > weeks - 4 },
                  ]}
                  x={wallGutter + month.column * wallPitch}
                  y={wallLabelHeight - 3}
                >
                  {month.label}
                </text>
              ))
            }
            {
              weekdayLabels.map((label, index) =>
                label ? (
                  <text
                    class="todo-wall-weekday"
                    x={wallGutter - 4}
                    y={wallLabelHeight + index * wallPitch + wallCell - 1}
                    text-anchor="end"
                  >
                    {label}
                  </text>
                ) : null,
              )
            }
          </svg>
        </div>

        {wallTotal === 0 && (
          <p class="todo-wall-empty">{i18n(I18nKey.todoHeatmapEmpty)}</p>
        )}
      </div>
    </div>
  </div>
</MainGridLayout>

<script
  is:inline
  define:vars={{
    checkinLabel: i18n(I18nKey.todoCheckin),
    todayCountTemplate,
    streakTemplate: i18n(I18nKey.todoStreak),
    wallTotalTemplate: heatmapTotalTemplate,
  }}
>
	(() => {
		const DONE_KEY = "blog-todo-state";
		const CHECK_KEY = "blog-todo-checks";

		const readMap = (key) => {
			try {
				const parsed = JSON.parse(localStorage.getItem(key) || "{}");
				return parsed && typeof parsed === "object" ? parsed : {};
			} catch {
				return {};
			}
		};

		const writeMap = (key, value) => {
			try {
				localStorage.setItem(key, JSON.stringify(value));
			} catch {
				/* 无痕模式下写不进去就算了，只影响刷新后是否记住 */
			}
		};

		const pad = (value) => String(value).padStart(2, "0");

		// 本地日期 YYYY-MM-DD
		const dayKey = (date) => {
			const target = date ? new Date(date) : new Date();
			return `${target.getFullYear()}-${pad(target.getMonth() + 1)}-${pad(target.getDate())}`;
		};

		// 一条打卡记录："2026-10-20" 或 "2026-10-20 22:31"
		const entryNow = () => {
			const now = new Date();
			return `${dayKey(now)} ${pad(now.getHours())}:${pad(now.getMinutes())}`;
		};
		const dayOf = (entry) => String(entry).slice(0, 10);
		const timeOf = (entry) => (String(entry).length > 10 ? String(entry).slice(11, 16) : "");

		// 本地补记的打卡：{ [id]: ["2026-10-20 22:31", ...] }
		// （兼容早期存成 { "2026-10-20": 2 } 的格式）
		const localEntriesOf = (state, id) => {
			const raw = state[id];
			if (!raw) return [];
			if (Array.isArray(raw)) return raw.map((value) => String(value));
			if (typeof raw === "object") {
				const entries = [];
				for (const [day, count] of Object.entries(raw)) {
					for (let index = 0; index < (Number(count) || 0); index += 1) {
						entries.push(day);
					}
				}
				return entries;
			}
			return [];
		};

		// markdown 里的打卡记录（可以有重复，重复就是一天打了多次）
		const markdownEntriesOf = (item) =>
			(item.getAttribute("data-checkins") || "")
				.split(",")
				.map((value) => value.trim())
				.filter(Boolean);

		// markdown + 本地补记
		const allEntriesOf = (item, state) => [
			...markdownEntriesOf(item),
			...localEntriesOf(state, item.getAttribute("data-todo-id")),
		];

		const streakOf = (dates) => {
			if (dates.length === 0) return 0;
			const days = new Set(dates);
			const cursor = new Date();
			if (!days.has(dayKey(cursor))) cursor.setDate(cursor.getDate() - 1);
			let streak = 0;
			while (days.has(dayKey(cursor))) {
				streak += 1;
				cursor.setDate(cursor.getDate() - 1);
			}
			return streak;
		};

		// 把本地状态刷到勾选框 / 进度条 / 打卡按钮上
		const paint = () => {
			const doneState = readMap(DONE_KEY);
			const checkState = readMap(CHECK_KEY);
			const items = Array.from(document.querySelectorAll("[data-todo-id]"));
			const today = dayKey();
			let done = 0;

			for (const item of items) {
				const id = item.getAttribute("data-todo-id");
				const box = item.querySelector("[data-todo-checkbox]");
				if (!box) continue;

				const row = item.querySelector("[data-todo-progress]");
				let completed = false;

				if (row) {
					const base = Number(row.getAttribute("data-base")) || 0;
					const totalPoints = Number(row.getAttribute("data-total")) || 0;
					const step = Number(row.getAttribute("data-step")) || 1;

					const entries = allEntriesOf(item, checkState);
					const todayEntries = entries.filter((entry) => dayOf(entry) === today);
					const count = entries.length;

					const value =
						totalPoints > 0 ? Math.min(totalPoints, base + count * step) : base;
					completed = totalPoints > 0 && value >= totalPoints;

					const bar = row.querySelector("[data-todo-bar]");
					const valueEl = row.querySelector("[data-todo-progress-value]");
					const todayEl = row.querySelector("[data-todo-today]");
					const undoEl = row.querySelector("[data-todo-undo]");
					const streakEl = row.querySelector("[data-todo-streak]");

					if (bar) {
						bar.style.width = `${
							totalPoints > 0 ? Math.round((value / totalPoints) * 100) : 0
						}%`;
					}
					if (valueEl) valueEl.textContent = String(value);

					if (undoEl) undoEl.hidden = todayEntries.length === 0;

					if (todayEl) {
						todayEl.hidden = todayEntries.length === 0;
						if (todayEntries.length > 0) {
							const times = todayEntries
								.map(timeOf)
								.filter(Boolean)
								.slice(-3);
							const label = todayCountTemplate.replace(
								"{count}",
								String(todayEntries.length),
							);
							todayEl.textContent = times.length
								? `${label} · ${times.join("、")}`
								: label;
						}
					}

					if (streakEl) {
						const streak = streakOf(entries.map(dayOf));
						streakEl.hidden = streak < 2;
						if (streak >= 2) {
							streakEl.textContent = streakTemplate.replace("{days}", String(streak));
						}
					}
				}

				// 本地覆盖优先，其次进度满了就算完成
				if (Object.prototype.hasOwnProperty.call(doneState, id)) {
					box.checked = Boolean(doneState[id]);
				} else if (completed) {
					box.checked = true;
				}

				if (box.checked) done += 1;
			}

			const totalItems = items.length;
			const doneEl = document.querySelector("[data-todo-done]");
			const totalEl = document.querySelector("[data-todo-total]");
			const fill = document.querySelector("[data-todo-fill]");

			if (doneEl) doneEl.textContent = String(done);
			if (totalEl) totalEl.textContent = String(totalItems);
			if (fill) {
				fill.style.width = `${
					totalItems === 0 ? 0 : Math.round((done / totalItems) * 100)
				}%`;
			}
		};

		// 写进 markdown 成功后，把底部小墙对应那天点亮（不用等刷新）
		const bumpWall = (date) => {
			const svg = document.querySelector(".todo-wall-svg");
			if (!svg) return;

			const pitch = Number(svg.getAttribute("data-pitch")) || 11;
			const cell = Number(svg.getAttribute("data-cell")) || 9;
			const gutter = Number(svg.getAttribute("data-gutter")) || 22;
			const labelH = Number(svg.getAttribute("data-label-h")) || 12;
			const start = svg.getAttribute("data-start");
			if (!start) return;

			const startDate = new Date(`${start}T00:00:00.000Z`);
			const target = new Date(`${date}T00:00:00.000Z`);
			const offset = Math.round((target.getTime() - startDate.getTime()) / 86400000);
			if (offset < 0) return;

			let rect = svg.querySelector(`[data-wall-date="${date}"]`);
			if (!rect) {
				rect = document.createElementNS("http://www.w3.org/2000/svg", "rect");
				rect.setAttribute("rx", "2");
				rect.setAttribute("class", "todo-wall-cell");
				rect.setAttribute("width", String(cell));
				rect.setAttribute("height", String(cell));
				rect.setAttribute("x", String(gutter + Math.floor(offset / 7) * pitch));
				rect.setAttribute("y", String(labelH + (offset % 7) * pitch));
				rect.setAttribute("data-wall-date", date);
				rect.setAttribute("data-count", "0");
				svg.appendChild(rect);
			}

			const counts = Array.from(svg.querySelectorAll("[data-wall-date]")).map((el) =>
				el === rect
					? (Number(rect.getAttribute("data-count")) || 0) + 1
					: Number(el.getAttribute("data-count")) || 0,
			);
			rect.setAttribute("data-count", String(counts[counts.length - 1] ?? 1));

			const max = Math.max(1, ...counts);
			Array.from(svg.querySelectorAll("[data-wall-date]")).forEach((el, index) => {
				const value = counts[index];
				el.setAttribute(
					"data-level",
					value === 0
						? "0"
						: String(Math.min(4, Math.max(1, Math.ceil((value / max) * 4)))),
				);
			});

			const totalEl = document.querySelector("[data-todo-wall-total]");
			if (totalEl) {
				totalEl.textContent = wallTotalTemplate.replace(
					"{count}",
					String(counts.reduce((acc, value) => acc + value, 0)),
				);
			}

			const emptyEl = document.querySelector(".todo-wall-empty");
			if (emptyEl) emptyEl.remove();
		};

		// dev 下由 src/plugins/dev-todo-checkin.mjs 提供；线上没有这个接口就本地记一笔
		const commit = async (id, entry, mode) => {
			try {
				const query = new URLSearchParams({ id, entry });
				if (mode === "undo") query.set("mode", "undo");
				const response = await fetch(`/api/todo-check/?${query.toString()}`, {
					headers: { accept: "application/json" },
				});
				if (!response.ok) return false;
				const data = await response.json();
				return Boolean(data && data.ok);
			} catch {
				return false;
			}
		};

		const appendEntry = (item, entry) => {
			const entries = markdownEntriesOf(item);
			entries.push(entry);
			item.setAttribute("data-checkins", entries.join(","));
		};

		const removeLastEntry = (item, entry) => {
			const entries = markdownEntriesOf(item);
			const index = entries.lastIndexOf(entry);
			if (index === -1) return;
			entries.splice(index, 1);
			item.setAttribute("data-checkins", entries.join(","));
		};

		const addLocalEntry = (id, entry) => {
			const state = readMap(CHECK_KEY);
			const entries = localEntriesOf(state, id);
			entries.push(entry);
			state[id] = entries;
			writeMap(CHECK_KEY, state);
		};

		const popLocalEntry = (id) => {
			const state = readMap(CHECK_KEY);
			const entries = localEntriesOf(state, id);
			entries.pop();
			state[id] = entries;
			writeMap(CHECK_KEY, state);
		};

		// 打卡：dev 下写进 markdown；线上退回本地记录
		const checkin = async (button) => {
			const item = button.closest("[data-todo-id]");
			if (!item) return;

			const id = item.getAttribute("data-todo-id");
			const entry = entryNow();

			button.disabled = true;
			try {
				const ok = await commit(id, entry, "add");
				if (ok) {
					appendEntry(item, entry);
					paint();
					bumpWall(dayOf(entry));
				} else {
					addLocalEntry(id, entry);
					paint();
				}
			} finally {
				button.disabled = false;
				button.textContent = checkinLabel;
			}
		};

		// 撤销：优先撤本地补记的，其次撤 markdown 里的最后一条（只撤今天的）
		const undo = async (button) => {
			const item = button.closest("[data-todo-id]");
			if (!item) return;

			const id = item.getAttribute("data-todo-id");
			const today = dayKey();
			const localToday = localEntriesOf(readMap(CHECK_KEY), id).filter(
				(entry) => dayOf(entry) === today,
			);
			const markdownToday = markdownEntriesOf(item).filter(
				(entry) => dayOf(entry) === today,
			);

			button.disabled = true;
			try {
				if (localToday.length > 0) {
					popLocalEntry(id);
					paint();
					return;
				}
				if (markdownToday.length === 0) return;

				const entry = markdownToday[markdownToday.length - 1];
				const ok = await commit(id, entry, "undo");
				if (ok) {
					removeLastEntry(item, entry);
					paint();
				}
			} finally {
				button.disabled = false;
			}
		};

		// 记下「这条待办划没划掉」
		const rememberDone = (box) => {
			const item = box.closest("[data-todo-id]");
			if (!item) return;
			const state = readMap(DONE_KEY);
			state[item.getAttribute("data-todo-id")] = box.checked;
			writeMap(DONE_KEY, state);
			paint();
		};

		if (!window.__todoListReady) {
			window.__todoListReady = true;

			document.addEventListener("change", (event) => {
				const target = event.target;
				if (
					target instanceof HTMLInputElement &&
					target.matches("[data-todo-checkbox]")
				) {
					rememberDone(target);
				}
			});

			document.addEventListener("click", (event) => {
				const target = event.target instanceof Element ? event.target : null;
				if (!target) return;

				// 打卡按钮
				const button = target.closest("[data-todo-checkin]");
				if (button) {
					event.preventDefault();
					checkin(button);
					return;
				}

				// 撤销按钮
				const undoButton = target.closest("[data-todo-undo]");
				if (undoButton) {
					event.preventDefault();
					undo(undoButton);
					return;
				}

				// 点整行也能勾掉，但不要抢链接、勾选框、进度条的交互
				const item = target.closest("[data-todo-id]");
				if (!item) return;
				if (target.closest("a, button, .todo-check, [data-todo-progress]")) {
					return;
				}
				const box = item.querySelector("[data-todo-checkbox]");
				if (!box) return;
				box.checked = !box.checked;
				rememberDone(box);
			});

			// swup 切页后 DOM 会被替换，重新刷一遍
			document.addEventListener("swup:contentReplaced", paint);
		}

		paint();
	})();
</script>

