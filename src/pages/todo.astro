---
import { getCollection, render } from "astro:content";
import { Icon } from "astro-icon/components";
import { siteConfig, todoConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";

// 在 todoConfig 里关闭后，导航栏不显示入口，页面直接跳 404
if (!todoConfig.enable) {
	return Astro.redirect("/404/");
}

const MS_PER_DAY = 86_400_000;

const LOCALE_MAP: Record<string, string> = {
	zh_CN: "zh-CN",
	zh_TW: "zh-TW",
	en: "en-US",
	ja: "ja-JP",
	ru: "ru-RU",
};

const locale = LOCALE_MAP[siteConfig.lang] ?? "en-US";
const title = todoConfig.title || i18n(I18nKey.todo);
const description = todoConfig.description || i18n(I18nKey.todoDescription);
const heatmapTotalTemplate = i18n(I18nKey.todoHeatmapTotal);

const entries = await getCollection("todos");

// 待办的正文会当作 markdown 备注渲染出来（可以写链接、列表、图片）
const items = await Promise.all(
	entries.map(async (entry) => {
		const progress = entry.data.progress ?? 0;
		const progressTotal = entry.data.progressTotal;
		const progressStep = entry.data.progressStep ?? 1;

		// checkins 是写进 markdown 的打卡日期，进度 = progress + 打卡天数 × progressStep
		const checkins = [
			...new Set((entry.data.checkins ?? []).map((date) => formatDateToYYYYMMDD(date))),
		].sort();
		const value = progressTotal
			? Math.min(progressTotal, progress + checkins.length * progressStep)
			: progress;

		return {
			id: entry.id,
			title: entry.data.title,
			done: entry.data.done ?? false,
			description: entry.data.description ?? "",
			date: entry.data.date,
			progress,
			progressTotal,
			progressStep,
			progressUnit: entry.data.progressUnit ?? "",
			checkins,
			value,
			percent:
				progressTotal && progressTotal > 0
					? Math.min(100, Math.round((value / progressTotal) * 100))
					: 0,
			Note: entry.body?.trim() ? (await render(entry)).Content : null,
		};
	}),
);

// 未完成的排前面，完成的沉底；同组按日期倒序
const todos = items.sort((a, b) => {
	if (a.done !== b.done) return a.done ? 1 : -1;
	const aTime = a.date ? a.date.getTime() : 0;
	const bTime = b.date ? b.date.getTime() : 0;
	if (aTime !== bTime) return bTime - aTime;
	return a.title.localeCompare(b.title);
});

const total = todos.length;
const doneCount = todos.filter((todo) => todo.done).length;
const percent = total === 0 ? 0 : Math.round((doneCount / total) * 100);

/* ---------- 底部「打卡记录」小墙：所有待办的打卡日期汇总 ---------- */

const checkinCounts = new Map<string, number>();
for (const item of items) {
	for (const day of item.checkins) {
		checkinCounts.set(day, (checkinCounts.get(day) ?? 0) + 1);
	}
}
const wallTotal = [...checkinCounts.values()].reduce((sum, count) => sum + count, 0);

const weeks = Math.min(
	53,
	Math.max(4, Math.floor(todoConfig.heatmapWeeks ?? 26)),
);

const timeZone = siteConfig.timezone;
const todayKey = new Intl.DateTimeFormat("en-CA", {
	year: "numeric",
	month: "2-digit",
	day: "2-digit",
	...(timeZone ? { timeZone } : {}),
}).format(new Date());

const todayUTC = new Date(`${todayKey}T00:00:00.000Z`);
const rangeStart = new Date(
	todayUTC.getTime() - (todayUTC.getUTCDay() + (weeks - 1) * 7) * MS_PER_DAY,
);

type WallDay = { key: string; count: number; level: number; future: boolean };

const wallDays: WallDay[] = [];
for (let index = 0; index < weeks * 7; index += 1) {
	const date = new Date(rangeStart.getTime() + index * MS_PER_DAY);
	const key = date.toISOString().slice(0, 10);
	wallDays.push({
		key,
		count: checkinCounts.get(key) ?? 0,
		level: 0,
		future: date.getTime() > todayUTC.getTime(),
	});
}

const maxDayCount = Math.max(1, ...wallDays.map((day) => day.count));
for (const day of wallDays) {
	day.level =
		day.count === 0
			? 0
			: Math.min(4, Math.max(1, Math.ceil((day.count / maxDayCount) * 4)));
}

const monthFormatter = new Intl.DateTimeFormat(locale, {
	month: "short",
	timeZone: "UTC",
});
const monthLabels: { column: number; label: string }[] = [];
for (let week = 0; week < weeks; week += 1) {
	let labeled = false;
	for (let dayOfWeek = 0; dayOfWeek < 7 && !labeled; dayOfWeek += 1) {
		const date = new Date(`${wallDays[week * 7 + dayOfWeek].key}T00:00:00.000Z`);
		if (date.getUTCDate() !== 1) continue;
		if (monthLabels.some((item) => week - item.column < 3)) continue;
		monthLabels.push({ column: week, label: monthFormatter.format(date) });
		labeled = true;
	}
}
if (monthLabels.length === 0 || monthLabels[0].column > 3) {
	monthLabels.unshift({
		column: 0,
		label: monthFormatter.format(new Date(`${wallDays[0].key}T00:00:00.000Z`)),
	});
}

const weekdayFormatter = new Intl.DateTimeFormat(locale, {
	weekday: "short",
	timeZone: "UTC",
});
const referenceSunday = new Date("2024-01-07T00:00:00.000Z");
const weekdayLabels = Array.from({ length: 7 }, (_, index) =>
	index === 1 || index === 3 || index === 5
		? weekdayFormatter.format(
				new Date(referenceSunday.getTime() + index * MS_PER_DAY),
			)
		: "",
);
---

<MainGridLayout title={title} description={description}>
  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-6 py-6 md:px-9 relative w-full onload-animation">
      <!-- 标题 -->
      <div class="flex items-center gap-3 mb-5">
        <div class="flex items-center justify-center h-9 w-9 rounded-xl bg-(--btn-regular-bg) text-(--btn-content) text-[1.5rem] flex-none">
          <Icon name="material-symbols:checklist-rounded" />
        </div>
        <div class="min-w-0">
          <h2 class="text-2xl font-bold leading-tight text-(--deep-text) m-0">{title}</h2>
          <p class="text-sm text-(--content-meta) mt-1 mb-0">{description}</p>
        </div>
      </div>

      {
        todoConfig.showProgress !== false && (
          <div class="todo-progress">
            <div class="todo-progress-track">
              <div class="todo-progress-fill" data-todo-fill style={`width:${percent}%`} />
            </div>
            <div class="todo-progress-text">
              <span data-todo-done>{doneCount}</span>
              <span class="mx-0.5">/</span>
              <span data-todo-total>{total}</span>
              <span class="ml-1">{i18n(I18nKey.todoCompleted)}</span>
            </div>
          </div>
        )
      }

      {
        total === 0 ? (
          <p class="todo-empty">{i18n(I18nKey.todoEmpty)}</p>
        ) : (
          <ul class="todo-list">
            {todos.map((todo) => {
              const Note = todo.Note;
              return (
                <li
                  class="todo-item"
                  data-todo-id={todo.id}
                  data-checkins={todo.checkins.join(",")}
                >
                  <label class="todo-check">
                    <input
                      type="checkbox"
                      class="todo-checkbox"
                      checked={todo.done}
                      data-todo-checkbox
                      aria-label={todo.title}
                    />
                    <span class="todo-check-mark" aria-hidden="true">
                      <Icon name="material-symbols:check-rounded" />
                    </span>
                  </label>
                  <div class="todo-body">
                    <div class="todo-title-row">
                      <span class="todo-title">{todo.title}</span>
                      {todo.date && (
                        <span class="todo-date">{formatDateToYYYYMMDD(todo.date)}</span>
                      )}
                    </div>
                    {todo.description && <p class="todo-desc">{todo.description}</p>}

                    {todo.progressTotal ? (
                      <div
                        class="todo-progress-row"
                        data-todo-progress
                        data-base={todo.progress}
                        data-total={todo.progressTotal}
                        data-step={todo.progressStep}
                      >
                        <div class="todo-progress-track">
                          <div
                            class="todo-progress-fill"
                            data-todo-bar
                            style={`width:${todo.percent}%`}
                          />
                        </div>
                        <span class="todo-progress-count">
                          <span data-todo-progress-value>{todo.value}</span>
                          <span class="mx-0.5">/</span>
                          <span>{todo.progressTotal}</span>
                          {todo.progressUnit && (
                            <span class="ml-0.5">{todo.progressUnit}</span>
                          )}
                        </span>
                        <button type="button" class="todo-checkin" data-todo-checkin>
                          {i18n(I18nKey.todoCheckin)}
                        </button>
                        <span class="todo-streak" data-todo-streak hidden />
                      </div>
                    ) : null}

                    {Note && (
                      <div class="todo-note prose dark:prose-invert prose-sm max-w-none! custom-md">
                        <Note />
                      </div>
                    )}
                  </div>
                </li>
              );
            })}
          </ul>
        )
      }

      <!-- 打卡记录小墙（数据来自各待办 markdown 里的 checkins） -->
      <div class="todo-wall">
        <div class="todo-wall-head">
          <span class="todo-wall-title">
            <Icon name="material-symbols:local-fire-department-rounded" class="todo-wall-icon" />
            {i18n(I18nKey.todoHeatmap)}
          </span>
          <span class="todo-wall-total" data-todo-wall-total>
            {heatmapTotalTemplate.replace("{count}", String(wallTotal))}
          </span>
        </div>

        <div class="todo-wall-scroll">
          <div
            class="todo-wall-canvas"
            style={`--wall-cell:9px;--wall-gap:2px;--wall-weeks:${weeks};`}
          >
            <div class="todo-wall-row">
              <div class="todo-wall-gutter" aria-hidden="true"></div>
              <div class="todo-wall-months">
                {monthLabels.map((month) => (
                  <span
                    class:list={[
                      "todo-wall-month",
                      { "todo-wall-month-end": month.column > weeks - 4 },
                    ]}
                    style={`grid-column:${month.column + 1}`}
                  >
                    {month.label}
                  </span>
                ))}
              </div>
            </div>
            <div class="todo-wall-row">
              <div class="todo-wall-weekdays" aria-hidden="true">
                {weekdayLabels.map((label) => (
                  <span class="todo-wall-weekday">{label}</span>
                ))}
              </div>
              <div class="todo-wall-cells">
                {wallDays.map((day) => (
                  <span
                    class="todo-wall-cell"
                    data-level={day.level}
                    data-wall-date={day.key}
                    data-count={day.count}
                    data-future={day.future ? "true" : undefined}
                    title={
                      day.count > 0
                        ? `${day.key} · ${heatmapTotalTemplate.replace("{count}", String(day.count))}`
                        : undefined
                    }
                  />
                ))}
              </div>
            </div>
          </div>
        </div>

        {wallTotal === 0 && (
          <p class="todo-wall-empty">{i18n(I18nKey.todoHeatmapEmpty)}</p>
        )}
      </div>
    </div>
  </div>
</MainGridLayout>

<script
  is:inline
  define:vars={{
    checkinLabel: i18n(I18nKey.todoCheckin),
    checkedLabel: i18n(I18nKey.todoCheckedIn),
    streakTemplate: i18n(I18nKey.todoStreak),
    wallTotalTemplate: heatmapTotalTemplate,
  }}
>
	(() => {
		const DONE_KEY = "blog-todo-state";
		const CHECK_KEY = "blog-todo-checks";

		const readMap = (key) => {
			try {
				const parsed = JSON.parse(localStorage.getItem(key) || "{}");
				return parsed && typeof parsed === "object" ? parsed : {};
			} catch {
				return {};
			}
		};

		const writeMap = (key, value) => {
			try {
				localStorage.setItem(key, JSON.stringify(value));
			} catch {
				/* 无痕模式下写不进去就算了，只影响刷新后是否记住 */
			}
		};

		const pad = (value) => String(value).padStart(2, "0");

		// 本地日期 YYYY-MM-DD，一天只算一次
		const dayKey = (date) => {
			const target = date ? new Date(date) : new Date();
			return `${target.getFullYear()}-${pad(target.getMonth() + 1)}-${pad(target.getDate())}`;
		};

		// 从今天（今天还没打卡就从昨天）往回数连续打卡天数
		const streakOf = (days) => {
			const list = Array.isArray(days) ? days : [...days];
			if (list.length === 0) return 0;
			const checked = new Set(list);
			const cursor = new Date();
			if (!checked.has(dayKey(cursor))) cursor.setDate(cursor.getDate() - 1);
			let streak = 0;
			while (checked.has(dayKey(cursor))) {
				streak += 1;
				cursor.setDate(cursor.getDate() - 1);
			}
			return streak;
		};

		// markdown 里已记录的打卡 + 浏览器本地补的打卡（同一日期只算一次）
		const checkinSetOf = (item, localState) => {
			const fromMarkdown = (item.getAttribute("data-checkins") || "")
				.split(",")
				.map((value) => value.trim())
				.filter(Boolean);
			const id = item.getAttribute("data-todo-id");
			const local = Array.isArray(localState[id]) ? localState[id] : [];
			return new Set([...fromMarkdown, ...local]);
		};

		// 把本地状态刷到勾选框 / 进度条 / 打卡按钮上
		const paint = () => {
			const doneState = readMap(DONE_KEY);
			const checkState = readMap(CHECK_KEY);
			const items = Array.from(document.querySelectorAll("[data-todo-id]"));
			const today = dayKey();
			let done = 0;

			for (const item of items) {
				const id = item.getAttribute("data-todo-id");
				const box = item.querySelector("[data-todo-checkbox]");
				if (!box) continue;

				const row = item.querySelector("[data-todo-progress]");
				let completed = false;

				if (row) {
					const base = Number(row.getAttribute("data-base")) || 0;
					const totalPoints = Number(row.getAttribute("data-total")) || 0;
					const step = Number(row.getAttribute("data-step")) || 1;
					const days = checkinSetOf(item, checkState);
					const value =
						totalPoints > 0 ? Math.min(totalPoints, base + days.size * step) : base;
					completed = totalPoints > 0 && value >= totalPoints;

					const bar = row.querySelector("[data-todo-bar]");
					const valueEl = row.querySelector("[data-todo-progress-value]");
					const button = row.querySelector("[data-todo-checkin]");
					const streakEl = row.querySelector("[data-todo-streak]");

					if (bar) {
						bar.style.width = `${
							totalPoints > 0 ? Math.round((value / totalPoints) * 100) : 0
						}%`;
					}
					if (valueEl) valueEl.textContent = String(value);

					if (button) {
						const checkedIn = days.has(today);
						button.disabled = checkedIn;
						button.textContent = checkedIn ? checkedLabel : checkinLabel;
					}

					if (streakEl) {
						const streak = streakOf(days);
						streakEl.hidden = streak < 2;
						if (streak >= 2) {
							streakEl.textContent = streakTemplate.replace("{days}", String(streak));
						}
					}
				}

				// 本地覆盖优先，其次进度满了就算完成
				if (Object.prototype.hasOwnProperty.call(doneState, id)) {
					box.checked = Boolean(doneState[id]);
				} else if (completed) {
					box.checked = true;
				}

				if (box.checked) done += 1;
			}

			const totalItems = items.length;
			const doneEl = document.querySelector("[data-todo-done]");
			const totalEl = document.querySelector("[data-todo-total]");
			const fill = document.querySelector("[data-todo-fill]");

			if (doneEl) doneEl.textContent = String(done);
			if (totalEl) totalEl.textContent = String(totalItems);
			if (fill) {
				fill.style.width = `${
					totalItems === 0 ? 0 : Math.round((done / totalItems) * 100)
				}%`;
			}
		};

		// 打卡成功后，把底部小墙里对应那天也点亮（不用等刷新）
		const bumpWall = (date) => {
			const cell = document.querySelector(`[data-wall-date="${date}"]`);
			if (!cell) return;

			const count = (Number(cell.getAttribute("data-count")) || 0) + 1;
			cell.setAttribute("data-count", String(count));

			const cells = Array.from(document.querySelectorAll("[data-wall-date]"));
			const counts = cells.map((element) =>
				element === cell ? count : Number(element.getAttribute("data-count")) || 0,
			);
			const max = Math.max(1, ...counts);
			cells.forEach((element, index) => {
				const value = counts[index];
				element.setAttribute(
					"data-level",
					value === 0 ? "0" : String(Math.min(4, Math.max(1, Math.ceil((value / max) * 4)))),
				);
			});

			const totalEl = document.querySelector("[data-todo-wall-total]");
			if (totalEl) {
				const sum = counts.reduce((acc, value) => acc + value, 0);
				totalEl.textContent = wallTotalTemplate.replace("{count}", String(sum));
			}

			const emptyEl = document.querySelector(".todo-wall-empty");
			if (emptyEl) emptyEl.remove();
		};

		// 本地记一笔（线上就靠它）；dev 下再顺手写进 markdown
		const checkin = (button) => {
			const item = button.closest("[data-todo-id]");
			if (!item) return;
			const id = item.getAttribute("data-todo-id");
			const state = readMap(CHECK_KEY);
			const days = Array.isArray(state[id]) ? state[id] : [];
			const today = dayKey();
			if (days.includes(today)) return;

			state[id] = days.concat(today);
			writeMap(CHECK_KEY, state);
			paint();
			bumpWall(today);
			commit(id, today);
		};

		// dev 下由 src/plugins/dev-todo-checkin.mjs 提供，线上没有这个接口就静默失败
		const commit = async (id, date) => {
			try {
				const response = await fetch(
					`/api/todo-check/?id=${encodeURIComponent(id)}&date=${encodeURIComponent(date)}`,
					{ headers: { accept: "application/json" } },
				);
				if (!response.ok) return;
				await response.json();
			} catch {
				/* 线上没有这个接口，保持本地状态即可 */
			}
		};

		// 记下「这条待办划没划掉」
		const rememberDone = (box) => {
			const item = box.closest("[data-todo-id]");
			if (!item) return;
			const state = readMap(DONE_KEY);
			state[item.getAttribute("data-todo-id")] = box.checked;
			writeMap(DONE_KEY, state);
			paint();
		};

		if (!window.__todoListReady) {
			window.__todoListReady = true;

			document.addEventListener("change", (event) => {
				const target = event.target;
				if (
					target instanceof HTMLInputElement &&
					target.matches("[data-todo-checkbox]")
				) {
					rememberDone(target);
				}
			});

			document.addEventListener("click", (event) => {
				const target = event.target instanceof Element ? event.target : null;
				if (!target) return;

				// 打卡按钮
				const button = target.closest("[data-todo-checkin]");
				if (button) {
					event.preventDefault();
					checkin(button);
					return;
				}

				// 点整行也能勾掉，但不要抢链接、勾选框、进度条的交互
				const item = target.closest("[data-todo-id]");
				if (!item) return;
				if (target.closest("a, button, .todo-check, [data-todo-progress]")) {
					return;
				}
				const box = item.querySelector("[data-todo-checkbox]");
				if (!box) return;
				box.checked = !box.checked;
				rememberDone(box);
			});

			// swup 切页后 DOM 会被替换，重新刷一遍
			document.addEventListener("swup:contentReplaced", paint);
		}

		paint();
	})();
</script>

<style>
	.todo-progress {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 1.25rem;
	}

	.todo-progress-track {
		position: relative;
		flex: 1;
		height: 6px;
		border-radius: 999px;
		background-color: var(--btn-regular-bg);
		overflow: hidden;
	}

	.todo-progress-fill {
		height: 100%;
		border-radius: inherit;
		background-color: var(--primary);
		transition: width 0.35s ease;
	}

	.todo-progress-text {
		flex: none;
		font-size: 0.8rem;
		color: var(--content-meta);
		font-variant-numeric: tabular-nums;
	}

	.todo-list {
		display: flex;
		flex-direction: column;
		gap: 2px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.todo-item {
		display: flex;
		align-items: flex-start;
		gap: 0.75rem;
		padding: 0.6rem 0.75rem;
		border-radius: 0.75rem;
		cursor: pointer;
		transition: background-color 0.15s ease;
	}

	.todo-item:hover {
		background-color: var(--btn-plain-bg-hover);
	}

	.todo-check {
		position: relative;
		display: inline-flex;
		flex: none;
		width: 1.3rem;
		height: 1.3rem;
		margin-top: 0.15rem;
		cursor: pointer;
	}

	.todo-checkbox {
		position: absolute;
		inset: 0;
		margin: 0;
		appearance: none;
		border-radius: 0.45rem;
		border: 1.5px solid color-mix(in oklab, var(--primary) 45%, transparent);
		background-color: transparent;
		cursor: pointer;
		transition:
			background-color 0.15s ease,
			border-color 0.15s ease;
	}

	.todo-checkbox:hover {
		border-color: var(--primary);
	}

	.todo-checkbox:focus-visible {
		outline: 2px solid color-mix(in oklab, var(--primary) 60%, transparent);
		outline-offset: 2px;
	}

	.todo-checkbox:checked {
		background-color: var(--primary);
		border-color: var(--primary);
	}

	.todo-check-mark {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
