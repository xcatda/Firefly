---
import { Icon } from "astro-icon/components";
import { checkinWallConfig, siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { getSortedPosts } from "@/utils/content-utils";
import { getPostUrlBySlug } from "@/utils/url-utils";

/**
 * 首页写作打卡墙
 *
 * 类似 GitHub 贡献图的「打卡墙」：一格代表一天，颜色越深代表当天发布的文章越多。
 * 数据来自站内文章的发布日期（可选叠加更新日期），构建期直接渲染，无需外部接口。
 *
 * 性能：整块热力图用一个 SVG 渲染——空格用 <pattern> 平铺，只有「有文章的日期」才画
 * 一个 <rect>，所以一年的墙只占一两 KB，页面里也不带任何 JS。
 */

interface Props {
	class?: string;
	style?: string;
	/** 显示的周数，不传则读取 checkinWallConfig.weeks */
	weeks?: number;
}

const { class: className, style, weeks: weeksProp } = Astro.props;

const MS_PER_DAY = 86_400_000;

const LOCALE_MAP: Record<string, string> = {
	zh_CN: "zh-CN",
	zh_TW: "zh-TW",
	en: "en-US",
	ja: "ja-JP",
	ru: "ru-RU",
};

const locale = LOCALE_MAP[siteConfig.lang] ?? "en-US";
const timeZone = siteConfig.timezone;
const weeks = Math.min(
	60,
	Math.max(4, Math.floor(weeksProp ?? checkinWallConfig.weeks ?? 53)),
);
const cellSize = Math.max(6, Math.floor(checkinWallConfig.cellSize ?? 11));
const cellGap = Math.max(1, Math.floor(checkinWallConfig.cellGap ?? 3));
const pitch = cellSize + cellGap;
const gutter = 26; // 左侧星期标签宽度
const labelHeight = 14; // 顶部月份标签高度
const gridWidth = weeks * pitch - cellGap;
const gridHeight = 7 * pitch - cellGap;

// 以站点时区取「日期」字符串，避免构建机时区造成偏移
const dayKeyFormatter = new Intl.DateTimeFormat("en-CA", {
	year: "numeric",
	month: "2-digit",
	day: "2-digit",
	...(timeZone ? { timeZone } : {}),
});

const toDayKey = (date: Date): string => dayKeyFormatter.format(date);
const fromDayKey = (key: string): Date => new Date(`${key}T00:00:00.000Z`);

type WallPost = { title: string; url: string };
type WallDay = {
	key: string;
	label: string;
	count: number;
	level: number;
	posts: WallPost[];
	week: number;
	weekday: number;
	future: boolean;
};

const postsByDay = new Map<string, WallPost[]>();

const addPostToDay = (dayKey: string, post: WallPost) => {
	const list = postsByDay.get(dayKey) ?? [];
	if (!list.some((item) => item.url === post.url)) {
		list.push(post);
	}
	postsByDay.set(dayKey, list);
};

for (const post of await getSortedPosts()) {
	if (post.data.draft) continue;

	const entry: WallPost = {
		title: post.data.title,
		url: getPostUrlBySlug(post.id),
	};

	const published =
		post.data.published instanceof Date
			? post.data.published
			: new Date(post.data.published);
	if (!Number.isNaN(published.getTime())) {
		addPostToDay(toDayKey(published), entry);
	}

	if (checkinWallConfig.countUpdated && post.data.updated) {
		const updated =
			post.data.updated instanceof Date
				? post.data.updated
				: new Date(post.data.updated);
		if (!Number.isNaN(updated.getTime())) {
			addPostToDay(toDayKey(updated), entry);
		}
	}
}

const today = fromDayKey(toDayKey(new Date()));
const todayWeekday = today.getUTCDay();
// 最后一列是本周（周日 → 周六），第一列是 weeks - 1 周之前的周日
const rangeStart = new Date(
	today.getTime() - (todayWeekday + (weeks - 1) * 7) * MS_PER_DAY,
);

const longDateFormatter = new Intl.DateTimeFormat(locale, {
	year: "numeric",
	month: "long",
	day: "numeric",
	timeZone: "UTC",
});

const days: WallDay[] = [];
for (let index = 0; index < weeks * 7; index += 1) {
	const date = new Date(rangeStart.getTime() + index * MS_PER_DAY);
	const key = date.toISOString().slice(0, 10);
	const dayPosts = postsByDay.get(key) ?? [];
	days.push({
		key,
		label: longDateFormatter.format(date),
		count: dayPosts.length,
		level: 0,
		posts: dayPosts,
		week: Math.floor(index / 7),
		weekday: index % 7,
		future: date.getTime() > today.getTime(),
	});
}

// 按一年内的最高产出来分配 4 级色阶，文章较少时也能看出深浅
const maxDayCount = Math.max(1, ...days.map((day) => day.count));
for (const day of days) {
	day.level =
		day.count === 0
			? 0
			: Math.min(4, Math.max(1, Math.ceil((day.count / maxDayCount) * 4)));
}

const pastDays = days.filter((day) => !day.future);
const totalPosts = pastDays.reduce((sum, day) => sum + day.count, 0);
const activeDays = pastDays.filter((day) => day.count > 0).length;

let longestStreak = 0;
let runningStreak = 0;
for (const day of pastDays) {
	runningStreak = day.count > 0 ? runningStreak + 1 : 0;
	longestStreak = Math.max(longestStreak, runningStreak);
}

let currentStreak = 0;
let streakCursor = pastDays.length - 1;
if (streakCursor >= 0 && pastDays[streakCursor].count === 0) {
	streakCursor -= 1;
}
while (streakCursor >= 0 && pastDays[streakCursor].count > 0) {
	currentStreak += 1;
	streakCursor -= 1;
}

// 月份标签：在包含「1 号」的那一列标注月份
const monthFormatter = new Intl.DateTimeFormat(locale, {
	month: "short",
	timeZone: "UTC",
});
const monthLabels: { column: number; label: string }[] = [];
for (let week = 0; week < weeks; week += 1) {
	let labeled = false;
	for (let dayOfWeek = 0; dayOfWeek < 7 && !labeled; dayOfWeek += 1) {
		const date = fromDayKey(days[week * 7 + dayOfWeek].key);
		if (date.getUTCDate() !== 1) continue;
		if (monthLabels.some((item) => week - item.column < 3)) continue;
		monthLabels.push({ column: week, label: monthFormatter.format(date) });
		labeled = true;
	}
}
if (monthLabels.length === 0 || monthLabels[0].column > 3) {
	monthLabels.unshift({
		column: 0,
		label: monthFormatter.format(fromDayKey(days[0].key)),
	});
}

// 星期标签只显示周一、周三、周五（与 GitHub 一致）
const weekdayFormatter = new Intl.DateTimeFormat(locale, {
	weekday: "short",
	timeZone: "UTC",
});
const referenceSunday = fromDayKey("2024-01-07");
const weekdayLabels = Array.from({ length: 7 }, (_, index) =>
	index === 1 || index === 3 || index === 5
		? weekdayFormatter.format(
				new Date(referenceSunday.getTime() + index * MS_PER_DAY),
			)
		: "",
);

const title = checkinWallConfig.title || i18n(I18nKey.checkinWall);
const subtitle =
	checkinWallConfig.subtitle || i18n(I18nKey.checkinWallSubtitle);
const dayPostsTemplate = i18n(I18nKey.checkinWallDayPosts);
const dayUnit = i18n(I18nKey.siteStatsDays).replace("{days}", "").trim();

const stats = [
	{ label: i18n(I18nKey.siteStatsPostCount), value: totalPosts },
	{ label: i18n(I18nKey.checkinWallActiveDays), value: activeDays },
	{ label: i18n(I18nKey.checkinWallLongestStreak), value: longestStreak },
];

const activeDaysList = days.filter((day) => day.level > 0);
const summaryLabel = `${title}：${i18n(I18nKey.siteStatsPostCount)} ${totalPosts}，${i18n(I18nKey.checkinWallActiveDays)} ${activeDays}`;

// 唯一 id，避免同一页出现两块墙时 <pattern> 冲突
const patternId = `checkin-wall-${Math.random().toString(36).slice(2, 8)}`;

const wallStyle = `--wall-cell:${cellSize}px;--wall-gap:${cellGap}px;${style ?? ""}`;
---

<div
	id="checkin-wall"
	class:list={["checkin-wall card-base onload-animation mb-4", className]}
	style={wallStyle}
	data-pagefind-ignore
>
	<div class="checkin-wall-inner">
		<div class="checkin-wall-header">
			<div class="checkin-wall-heading">
				<div class="checkin-wall-badge" aria-hidden="true">
					<Icon name="material-symbols:local-fire-department-rounded" />
				</div>
				<div class="min-w-0">
					<h2 class="checkin-wall-title">{title}</h2>
					<p class="checkin-wall-subtitle">{subtitle}</p>
				</div>
			</div>

			{
				checkinWallConfig.showStats !== false && (
					<div class="checkin-wall-stats">
						{stats.map((stat) => (
							<div class="checkin-wall-stat">
								<span class="checkin-wall-stat-value">{stat.value}</span>
								<span class="checkin-wall-stat-label">{stat.label}</span>
							</div>
						))}
					</div>
				)
			}
		</div>

		<div class="checkin-wall-scroll custom-scrollbar">
			<svg
				class="checkin-wall-svg"
				width={gutter + gridWidth}
				height={labelHeight + gridHeight}
				viewBox={`0 0 ${gutter + gridWidth} ${labelHeight + gridHeight}`}
				role="img"
				aria-label={summaryLabel}
			>
				<defs>
					<pattern
						id={patternId}
						width={pitch}
						height={pitch}
						patternUnits="userSpaceOnUse"
					>
						<rect
							width={cellSize}
							height={cellSize}
							rx="2"
							class="checkin-wall-cell-empty"
						/>
					</pattern>
				</defs>

				{/* 空格：用 pattern 平铺，只画两块矩形 */}
				<rect
					x={gutter}
					y={labelHeight}
					width={gridWidth - pitch}
					height={gridHeight}
					fill={`url(#${patternId})`}
				/>
				<rect
					x={gutter + gridWidth - pitch}
					y={labelHeight}
					width={cellSize}
					height={(todayWeekday + 1) * pitch - cellGap}
					fill={`url(#${patternId})`}
				/>

				{/* 有文章的日期 */}
				{
					activeDaysList.map((day) => (
						<rect
							x={gutter + day.week * pitch}
							y={labelHeight + day.weekday * pitch}
							width={cellSize}
							height={cellSize}
							rx="2"
							class="checkin-wall-cell"
							data-level={day.level}
						>
							<title>
								{`${day.label} · ${dayPostsTemplate.replace("{count}", String(day.count))}`}
							</title>
						</rect>
					))
				}

				{/* 月份 / 星期标签 */}
				{
					monthLabels.map((month) => (
						<text
							class:list={[
								"checkin-wall-month",
								{ "checkin-wall-month-end": month.column > weeks - 4 },
							]}
							x={gutter + month.column * pitch}
							y={labelHeight - 4}
						>
							{month.label}
						</text>
					))
				}
				{
					weekdayLabels.map((label, index) =>
						label ? (
							<text
								class="checkin-wall-weekday"
								x={gutter - 5}
								y={labelHeight + index * pitch + cellSize - 1}
								text-anchor="end"
							>
								{label}
							</text>
						) : null,
					)
				}
			</svg>
		</div>

		<div class="checkin-wall-footer">
			<div class="checkin-wall-streak">
				<Icon
					name="material-symbols:bolt-rounded"
					class="checkin-wall-streak-icon"
					aria-hidden="true"
				/>
				<span>{i18n(I18nKey.checkinWallCurrentStreak)}</span>
				<strong>{currentStreak}</strong>
				<span>{dayUnit}</span>
			</div>

			{
				checkinWallConfig.showLegend !== false && (
					<div class="checkin-wall-legend" aria-hidden="true">
						<span>{i18n(I18nKey.checkinWallLess)}</span>
						{[0, 1, 2, 3, 4].map((level) => (
							<span class="checkin-wall-cell" data-level={level} />
						))}
						<span>{i18n(I18nKey.checkinWallMore)}</span>
					</div>
				)
			}
		</div>
	</div>
</div>

<style>
	.checkin-wall {
		--wall-cell: 11px;
		--wall-gap: 3px;
		padding: 1rem 1.25rem 0.9rem;
	}

	.checkin-wall-inner {
		display: flex;
		flex-direction: column;
		width: 100%;
		min-width: 0;
	}

	.checkin-wall-header {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		margin-bottom: 0.95rem;
	}

	.checkin-wall-heading {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		min-width: 0;
	}

	.checkin-wall-badge {
		display: flex;
		align-items: center;
		justify-content: center;
		flex: none;
		width: 2.4rem;
		height: 2.4rem;
		border-radius: 0.85rem;
		background-color: var(--btn-regular-bg);
		color: var(--btn-content);
		font-size: 1.4rem;
	}

	.checkin-wall-title {
		margin: 0;
		font-size: 1.05rem;
		font-weight: 700;
		line-height: 1.3;
		color: var(--deep-text);
	}

	.checkin-wall-subtitle {
		margin: 2px 0 0;
		font-size: 0.72rem;
		line-height: 1.4;
		color: var(--content-meta);
	}

	.checkin-wall-stats {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem;
	}

	.checkin-wall-stat {
		display: inline-flex;
		align-items: baseline;
		gap: 0.25rem;
		padding: 0.2rem 0.6rem;
		border-radius: 999px;
		background-color: var(--btn-plain-bg-hover);
		white-space: nowrap;
	}

	.checkin-wall-stat-value {
		font-size: 0.9rem;
		font-weight: 700;
		color: var(--deep-text);
		font-variant-numeric: tabular-nums;
	}

	.checkin-wall-stat-label {
		font-size: 0.7rem;
		color: var(--content-meta);
	}

	.checkin-wall-scroll {
		overflow-x: auto;
		overflow-y: hidden;
	}

	.checkin-wall-svg {
		display: block;
	}

	.checkin-wall-svg .checkin-wall-cell-empty {
		fill: color-mix(in oklab, var(--primary) 10%, transparent);
	}

	.checkin-wall-svg .checkin-wall-cell {
		fill: color-mix(in oklab, var(--primary) 10%, transparent);
		transition: fill 0.2s ease;
	}

	.checkin-wall-svg .checkin-wall-cell[data-level="1"] {
		fill: color-mix(in oklab, var(--primary) 28%, transparent);
	}

	.checkin-wall-svg .checkin-wall-cell[data-level="2"] {
		fill: color-mix(in oklab, var(--primary) 48%, transparent);
	}

	.checkin-wall-svg .checkin-wall-cell[data-level="3"] {
		fill: color-mix(in oklab, var(--primary) 70%, transparent);
	}

	.checkin-wall-svg .checkin-wall-cell[data-level="4"] {
		fill: var(--primary);
	}

	.checkin-wall-svg .checkin-wall-cell:hover {
		fill: var(--primary);
	}

	.checkin-wall-month,
	.checkin-wall-weekday {
		fill: var(--content-meta);
		font-size: 9px;
		font-family: inherit;
	}

	.checkin-wall-month-end {
		text-anchor: end;
	}

	.checkin-wall-footer {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		margin-top: 0.85rem;
		font-size: 0.72rem;
		color: var(--content-meta);
	}

	.checkin-wall-streak {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
	}

	.checkin-wall-streak strong {
		font-weight: 700;
		color: var(--deep-text);
	}

	.checkin-wall-streak-icon {
		font-size: 1rem;
		color: var(--primary);
	}

	.checkin-wall-legend {
		display: inline-flex;
		align-items: center;
		gap: 4px;
	}

	/* 图例的小方块（HTML 元素，不是 SVG） */
	.checkin-wall-legend .checkin-wall-cell {
		display: block;
		width: 10px;
		height: 10px;
		border-radius: 2px;
		background-color: color-mix(in oklab, var(--primary) 10%, transparent);
	}

	.checkin-wall-legend .checkin-wall-cell[data-level="1"] {
		background-color: color-mix(in oklab, var(--primary) 28%, transparent);
	}

	.checkin-wall-legend .checkin-wall-cell[data-level="2"] {
		background-color: color-mix(in oklab, var(--primary) 48%, transparent);
	}

	.checkin-wall-legend .checkin-wall-cell[data-level="3"] {
		background-color: color-mix(in oklab, var(--primary) 70%, transparent);
	}

	.checkin-wall-legend .checkin-wall-cell[data-level="4"] {
		background-color: var(--primary);
	}

	@media (max-width: 640px) {
		.checkin-wall {
			padding: 0.85rem 0.9rem 0.8rem;
		}

		.checkin-wall-title {
			font-size: 1rem;
		}

		.checkin-wall-subtitle {
			font-size: 0.68rem;
		}
	}
</style>
